rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Two separate hashes avoid ambiguous title/author delimiters.
    // Every client must use this canonical id, so another id cannot bypass uniqueness.
    function canonicalId(data) {
      return request.auth.uid + '__'
        + hashing.sha256(data.title.trim().lower().toUtf8()).toHexString().lower() + '_'
        + hashing.sha256(data.author.trim().lower().toUtf8()).toHexString().lower();
    }

    function valid(data, bookId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'author', 'genre',
          'status', 'favorite', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'author', 'genre',
          'status', 'rating', 'favorite', 'notes', 'createdAt'])
        && data.userId == request.auth.uid
        && data.title is string && data.title.trim().size() > 0 && data.title.size() <= 100
        && data.author is string && data.author.trim().size() > 0 && data.author.size() <= 60
        && data.genre in ['Fiction', 'Non-Fiction', 'Academic', 'Other']
        && data.status in ['To Read', 'Reading', 'Finished']
        && (!('rating' in data) || data.rating == null
          || (data.rating is int && data.rating >= 0 && data.rating <= 5))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.favorite is bool
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.id == bookId && bookId == canonicalId(data);
    }

    match /books/{bookId} {
      // Transactions need to read a not-yet-existing canonical id before creating it.
      allow get: if signedIn() && (
        (resource != null && resource.data.userId == request.auth.uid)
        || (resource == null && bookId.matches(request.auth.uid + '__[a-f0-9]{64}_[a-f0-9]{64}'))
      );
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && valid(request.resource.data, bookId);
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && valid(request.resource.data, bookId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
